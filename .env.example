DATABASE_URL=postgresql://ff_user:ff_password@db:5432/fashion_forward
POSTGRES_USER=ff_user
POSTGRES_PASSWORD=ff_password
POSTGRES_DB=fashion_forward

# Change this to a long random string in any real deployment.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-insecure-secret-change-me

# Optional AI Photo Try-On. Never point this at a hosted provider.
# CatVTON requires a separate local NVIDIA/CUDA worker; its published
# license permits non-commercial use only. Keep false unless that applies.
CATVTON_WORKER_URL=
CATVTON_WORKER_TOKEN=
CATVTON_NONCOMMERCIAL_USE_CONFIRMED=false
CATVTON_REPO_PATH=
CATVTON_MIXED_PRECISION=bf16
CATVTON_CHECKPOINT_REPO=zhengchong/CatVTON
CATVTON_BASE_MODEL_PATH=stable-diffusion-v1-5/stable-diffusion-inpainting
HF_TOKEN=
